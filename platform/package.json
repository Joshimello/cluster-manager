{
  "name": "cluster-manager-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node scripts/migrate.mjs",
    "dev:seed-workstations": "node scripts/seed-dev-workstations.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:auth-smoke": "node scripts/auth-smoke.mjs",
    "test:node-smoke": "node scripts/node-smoke.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.46.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.5",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "devalue": "5.9.2",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "^1.6.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  }
}
