# Copy to .env and replace every change-me value before starting production.
COMPOSE_PROJECT_NAME=cluster-manager
POSTGRES_DB=cluster_manager
POSTGRES_USER=cluster_manager
POSTGRES_PASSWORD=change-me-use-a-long-random-secret

# Public browser origin. TLS terminates at the reverse proxy.
ORIGIN=https://cluster.example.edu
PLATFORM_BIND_ADDRESS=127.0.0.1
PLATFORM_PORT=3000
PLATFORM_VERSION=0.1.0
TELEMETRY_RETENTION_HOURS=24
