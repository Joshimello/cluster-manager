# Development defaults only. Replace credentials before a production deployment.
COMPOSE_PROJECT_NAME=cluster-manager

POSTGRES_DB=cluster_manager
POSTGRES_USER=cluster_manager
POSTGRES_PASSWORD=cluster_manager_development_only
POSTGRES_PORT=5432

DEV_PLATFORM_PORT=5173
DEV_PLATFORM_ALLOWED_HOST=
PLATFORM_PORT=3000
ORIGIN=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Optional production updater setup: see docs/platform-updates.md.
# PLATFORM_VERSION=vX.Y.Z
# UPDATER_VERSION=vX.Y.Z
# PLATFORM_UPDATER_TOKEN=<64 random hexadecimal characters>
# DEPLOYMENT_DIRECTORY=/absolute/path/to/cluster-manager

# Development simulation only. Replace these if a shared development stack is exposed.
NODE_WS01_ENROLLMENT_TOKEN=cmenroll_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
NODE_WS02_ENROLLMENT_TOKEN=cmenroll_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
NODE_WS01_SIMULATION_SCENARIO=normal
NODE_WS02_SIMULATION_SCENARIO=multi-user

# 32 random bytes encoded as base64; keep stable and back up securely.
# Required when enabling connected application sign-in.
AUTH_ENCRYPTION_KEY=
